# -------- Stage 1: Build --------
FROM maven:3-eclipse-temurin-17 AS build

WORKDIR /app

# Copy only essential files
COPY pom.xml .
COPY src ./src

# Build JAR (skip test for faster build)
RUN mvn clean package -DskipTests

# Analyze dependencies directly from JAR
RUN jdeps --ignore-missing-deps \
    --recursive \
    --multi-release 17 \
    --print-module-deps \
    --class-path target/practiceProject-0.0.1-SNAPSHOT.jar \
    target/practiceProject-0.0.1-SNAPSHOT.jar > deps.info

# Create a custom JRE only with required modules
RUN jlink \
    --add-modules $(cat deps.info) \
    --strip-debug \
    --compress=2 \
    --no-header-files \
    --no-man-pages \
    --output /opt/jdk

# -------- Stage 2: Runtime --------
FROM debian:bookworm-slim

# Add non-root user
RUN useradd -r -u 1001 -g root appuser

# Install basic certs and tini (for clean shutdowns)
RUN apt-get update && apt-get install -y ca-certificates tini && \
    rm -rf /var/lib/apt/lists/*

# Set JAVA env
ENV JAVA_HOME=/opt/jdk
ENV PATH="$JAVA_HOME/bin:$PATH"

# Copy JRE & JAR from build stage
COPY --from=build /opt/jdk /opt/jdk
COPY --from=build /app/target/practiceProject-0.0.1-SNAPSHOT.jar /app/app.jar

WORKDIR /app
EXPOSE 8080

# Switch to non-root user
USER appuser

# Use tini as PID 1 for signal handling
ENTRYPOINT ["/usr/bin/tini", "--", "java", "-Duser.timezone=GMT+7", "-Dspring.profiles.active=prod", "-jar", "app.jar"]
